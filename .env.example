# LINE Messaging API channel (the bot / official account)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Login channel backing the LIFF app.
# LINE_LOGIN_CHANNEL_ID is verified against the ID token's `aud` claim server-side.
LINE_LOGIN_CHANNEL_ID=
# Public: this one is exposed to the browser.
NEXT_PUBLIC_LIFF_ID=

# Supabase. SUPABASE_SERVICE_KEY is the service role key: it bypasses RLS,
# so it must never be imported into anything that ships to the client.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Read by the Anthropic SDK itself, not via process.env.
ANTHROPIC_API_KEY=

# Bearer secret for /api/cron/reminders. If unset the route returns 401 for
# every request, which disables the daily summary and reminders but leaves the
# rest of the app working.
CRON_SECRET=

# Optional. Comma-separated LINE group allow-list; empty or unset accepts any
# group. Each listed group stays a separate household - this gates access, it
# never merges data.
ALLOWED_GROUP_ID=

# Discord webhook the admin watches. Alerts go here instead of over LINE, so
# they still arrive if the LINE messaging channel itself is what's broken.
DISCORD_WEBHOOK_URL=

# Optional. true logs push messages instead of sending them.
PUSH_DRY_RUN=

# Optional. true turns the missed-slot reminders back on. Off by default: each
# one costs a push per member (docs/decisions.md).
REMINDERS_ENABLED=
